rules_version = '2';

// ============================================================================
// Reglas de seguridad — Air Fryer Chef
// ----------------------------------------------------------------------------
// La lista de quién tiene acceso vive en el documento config/access, no aquí
// en las reglas — así que aprobar a una persona nueva es un clic dentro de
// la app (Configuración → Acceso y personas), sin volver a tocar este
// archivo ni redesplegar nada.
//
// La única lista que SÍ vive aquí, en `ROOT_ADMIN_UIDS`, es la de
// administradores "raíz": son quienes pueden crear config/access la primera
// vez (o recrearlo si algo se rompe). Rellénala con los UID de Firebase Auth
// de quien vaya a ser administrador, y despliega una única vez:
//
//   firebase deploy --only firestore:rules
//
// Después de eso, añadir o quitar personas normales ya NO requiere volver a
// tocar este archivo.
// ============================================================================

function rootAdminUids() {
  return ['OWNER_UID_PLACEHOLDER'];
}

function isRootAdmin() {
  return request.auth != null && request.auth.uid in rootAdminUids();
}

function isApproved() {
  return request.auth != null && (
    isRootAdmin() ||
    (
      exists(/databases/$(database)/documents/config/access) &&
      request.auth.uid in get(/databases/$(database)/documents/config/access).data.allowedUids
    )
  );
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Documento de control de acceso. Cualquier persona autenticada puede
    // leerlo (para saber si ya tiene acceso) y puede crear/actualizar
    // ÚNICAMENTE su propia entrada dentro de pendingRequests (para solicitar
    // acceso). Solo quien ya está aprobado (o es administrador raíz) puede
    // tocar allowedUids — es decir, aprobar, rechazar o revocar.
    match /config/access {
      allow read: if request.auth != null;
      allow create: if isRootAdmin();
      allow update: if request.auth != null && (
        isRootAdmin() ||
        request.auth.uid in resource.data.allowedUids ||
        (
          request.resource.data.allowedUids == resource.data.allowedUids &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingRequests']) &&
          request.resource.data.pendingRequests.diff(resource.data.pendingRequests).affectedKeys().hasOnly([request.auth.uid])
        )
      );
    }

    // Catálogo (modelos de Air Fryer, alimentos) y recetas: accesible por
    // cualquiera de las personas aprobadas. Las recetas en sí se comparten
    // entre todas ellas (p.ej. pareja/familia); lo que NO se comparte es la
    // despensa, favoritos, valoraciones y notas de cada persona, que viven
    // bajo users/{uid} y solo esa persona puede tocar.
    match /airFryerModels/{docId} {
      allow read, write: if isApproved();
    }
    match /foods/{docId} {
      allow read, write: if isApproved();
    }
    match /recipes/{docId} {
      allow read, write: if isApproved();
    }

    match /users/{uid} {
      allow read, write: if isApproved() && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if isApproved() && request.auth.uid == uid;
      }
    }
  }
}
