# Configuración pública de Firebase (no son secretos: identifican el proyecto,
# la seguridad real la dan las Firestore Security Rules + Firebase Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# UID de Firebase Auth del único usuario permitido (tú). Se rellena después
# de tu primer login con Google — ver README, paso 4.
VITE_OWNER_UID=

# URL del Worker de Cloudflare que hace de proxy seguro hacia Claude
VITE_AI_PROXY_URL=

# Nombre del repo de GitHub, para el base path de Vite (https://usuario.github.io/REPO/)
VITE_BASE_PATH=/airfryer-chef/
